<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tauri already sets PRODUCT_NAME to the productName at build time, so
	     CFBundleName resolves to Konvo. This is belt-and-braces: it pins
	     the home screen label even if the generated project changes. -->
	<key>CFBundleDisplayName</key>
	<string>Konvo</string>

	<!-- The app only speaks HTTPS to instagram.com and ships no custom
	     cryptography, which is exempt. Declaring it here stops every build
	     landing in TestFlight as "Missing Compliance", which would block
	     testers from installing until someone answered the prompt by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Without these, iOS does not deny the request - it kills the process the
	     instant the webview touches the camera, mic or library. That is the
	     "take photo crashes back to the home screen" bug. All three are reachable
	     from the message composer, so all three need a purpose string. -->
	<key>NSCameraUsageDescription</key>
	<string>Konvo uses the camera so you can take a photo for a conversation or your Instagram Story.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Konvo uses the microphone so you can record and send a voice note.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Konvo uses your photo library so you can choose a photo for a conversation or your Instagram Story.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Konvo saves photos from a conversation to your photo library when you download them.</string>
</dict>
</plist>
