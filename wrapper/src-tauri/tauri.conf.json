{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konvo",
  "version": "1.6.0",
  "identifier": "com.matthewchan.konvo",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "instamessages"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "JBTFJ7JD4R",
      "bundleVersion": "108"
    }
  }
}