# Site (Next.js on Vercel). Names only; the app needs none of these.
NEXT_PUBLIC_POSTHOG_KEY=            # PostHog project token for the site
NEXT_PUBLIC_HUMANBEHAVIOR_API_KEY=  # optional session analytics on the site
NEXT_PUBLIC_HUMANBEHAVIOR_INGESTION_URL=
UPSTASH_REDIS_REST_URL=             # invite loop, push tokens, and Android waitlist
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=                    # accepted as a fallback for the two above
KV_REST_API_TOKEN=
REVENUECAT_SECRET_KEY=              # server only: grants the 3 free days to invited friends
APNS_KEY_ID=                        # unread-message heartbeat pushes
APNS_TEAM_ID=
APNS_KEY_P8=                        # contents of the .p8, newlines escaped
APNS_TOPIC=                         # the app bundle id
PUSH_TICK_SECRET=                   # shared secret for the GitHub Actions clock
CRON_SECRET=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
