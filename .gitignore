# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.venv/
__pycache__/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
wrapper/src-tauri/target
extension/_metadata/
.gstack/
.env.local

# local agent tooling state (daemon pids, logs, metrics, vendored skills)
.claude-flow/
.claude/

docs/shipaton/ruvector.db

# Local agent memory databases (not application data)
ruvector.db
ruvector.db-*

# Apple signing material and generated distribution packages
*.p8
*.mobileprovision
*.ipa
*.xcarchive/
*.dSYM/
*.app/

# Local device installations, release receipts, logs, and analytics exports
wrapper/scripts/store*/
wrapper/scripts/build*.id
wrapper/experiments/device*/
wrapper/experiments/store*/
wrapper/experiments/build*.json
wrapper/experiments/posthog-*.json
wrapper/experiments/**/*.log
